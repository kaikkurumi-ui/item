<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aisia.item.module.mapper.FileMapper">


    <insert id="insert" parameterType="com.aisia.item.module.entity.FileEntity" useGeneratedKeys="true"
            keyProperty="id">
        insert into file (
        <trim suffixOverrides=",">
            <if test="type != null">
                `type`,
            </if>
            <if test="resourceUri != null and resourceUri != ''">
                resource_uri,
            </if>
            <if test="createTime != null">
                create_time,
            </if>
            <if test="updateTime != null">
                update_time,
            </if>
            is_deleted,
        </trim>
        ) VALUES (
        <trim suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="resourceUri != null and resourceUri != ''">#{resourceUri},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            #{isDeleted},
        </trim>
        )
    </insert>

    <update id="update" parameterType="com.aisia.item.module.entity.FileEntity">
        update file
        <set>
            <if test="type != null">
                `type` = #{type},
            </if>
            <if test="resourceUri != null and resourceUri != ''">
                resource_uri = #{resourceUri},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="isDeleted != null">
                is_deleted = #{isDeleted},
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>
